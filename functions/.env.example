# Copy to .env (git-ignored) before deploying if you want to override values.
# The live values are already set in .env and as defaults in index.js.
#
# When you rotate the EmailJS keys again:
#   1. Update EMAILJS_PUBLIC_KEY / EMAILJS_ACCESS_TOKEN in .env
#   2. firebase deploy --only functions

EMAILJS_SERVICE_ID=service_b5ez4ix
EMAILJS_TEMPLATE_ID=template_17hmw12
EMAILJS_PUBLIC_KEY=your-public-key
EMAILJS_ACCESS_TOKEN=your-private-access-token

# Milliseconds to wait after completion before building the report, so the
# rider app can finish uploading queued photos. Default: 120000 (2 minutes).
# REPORT_DELAY_MS=120000
